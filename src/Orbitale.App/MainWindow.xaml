<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Orbitale.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Orbitale.App.Controls"
    xmlns:vm="using:Orbitale.App.ViewModels"
    Title="Orbitale">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" RequestedTheme="Dark">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Toolbar -->
        <Grid Grid.Row="0" Padding="12,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <SplitButton
                    AutomationProperties.Name="Add frames"
                    Command="{x:Bind ViewModel.AddFramesCommand}"
                    IsEnabled="{x:Bind ViewModel.CanEditFrames, Mode=OneWay}"
                    ToolTipService.ToolTip="Add every JPG and TIFF of a folder">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE8F4;" />
                        <TextBlock Text="Add frames…" />
                    </StackPanel>
                    <SplitButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem Command="{x:Bind ViewModel.AddFramesCommand}" Text="Folder…">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8B7;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Command="{x:Bind ViewModel.AddFrameFilesCommand}" Text="Files…">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8A5;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>

                <AppBarSeparator />

                <ComboBox
                    MinWidth="120"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Blend mode"
                    IsEnabled="{x:Bind ViewModel.CanEditSettings, Mode=OneWay}"
                    SelectedIndex="{x:Bind ViewModel.ModeIndex, Mode=TwoWay}"
                    ToolTipService.ToolTip="Blend mode">
                    <x:String>Lighten</x:String>
                    <x:String>Darken</x:String>
                    <x:String>Average</x:String>
                </ComboBox>

                <ToggleSplitButton
                    AutomationProperties.Name="Comet style"
                    IsChecked="{x:Bind ViewModel.Comet, Mode=TwoWay}"
                    IsEnabled="{x:Bind ViewModel.CanUseLightenOptions, Mode=OneWay}"
                    ToolTipService.ToolTip="Comet style (Lighten only)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE734;" />
                        <TextBlock Text="Comet" />
                    </StackPanel>
                    <ToggleSplitButton.Flyout>
                        <Flyout Placement="Bottom">
                            <StackPanel Width="260" Spacing="8">
                                <Slider
                                    Header="{x:Bind controls:ViewFormat.Percent('Strength', ViewModel.CometStrength), Mode=OneWay}"
                                    AutomationProperties.Name="Comet strength"
                                    Maximum="100"
                                    Minimum="0"
                                    StepFrequency="1"
                                    Value="{x:Bind ViewModel.CometStrength, Mode=TwoWay}" />
                                <ToggleSwitch
                                    Header="Comet head at start"
                                    IsOn="{x:Bind ViewModel.HeadAtStart, Mode=TwoWay}" />
                            </StackPanel>
                        </Flyout>
                    </ToggleSplitButton.Flyout>
                </ToggleSplitButton>

                <ToggleSplitButton
                    AutomationProperties.Name="Gap filling"
                    IsChecked="{x:Bind ViewModel.GapFill, Mode=TwoWay}"
                    IsEnabled="{x:Bind ViewModel.CanUseLightenOptions, Mode=OneWay}"
                    ToolTipService.ToolTip="Gap filling (Lighten only)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE76F;" />
                        <TextBlock Text="Gap filling" />
                    </StackPanel>
                    <ToggleSplitButton.Flyout>
                        <Flyout Placement="Bottom">
                            <Slider
                                Width="260"
                                Header="{x:Bind controls:ViewFormat.Percent('Strength', ViewModel.GapFillStrength), Mode=OneWay}"
                                AutomationProperties.Name="Gap filling strength"
                                Maximum="100"
                                Minimum="0"
                                StepFrequency="1"
                                Value="{x:Bind ViewModel.GapFillStrength, Mode=TwoWay}" />
                        </Flyout>
                    </ToggleSplitButton.Flyout>
                </ToggleSplitButton>

                <ToggleSplitButton
                    AutomationProperties.Name="Remove trails"
                    IsChecked="{x:Bind ViewModel.RemoveTrails, Mode=TwoWay}"
                    IsEnabled="{x:Bind ViewModel.CanEditSettings, Mode=OneWay}"
                    ToolTipService.ToolTip="Remove plane and satellite trails">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE709;" />
                        <TextBlock Text="Remove trails" />
                    </StackPanel>
                    <ToggleSplitButton.Flyout>
                        <Flyout Placement="Bottom">
                            <Slider
                                Width="260"
                                Header="{x:Bind controls:ViewFormat.Percent('Sensitivity', ViewModel.TrailSensitivity), Mode=OneWay}"
                                AutomationProperties.Name="Trail sensitivity"
                                Maximum="100"
                                Minimum="0"
                                StepFrequency="1"
                                Value="{x:Bind ViewModel.TrailSensitivity, Mode=TwoWay}" />
                        </Flyout>
                    </ToggleSplitButton.Flyout>
                </ToggleSplitButton>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button
                    MinWidth="96"
                    AutomationProperties.Name="Start"
                    Command="{x:Bind ViewModel.StartCommand}"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE768;" />
                        <TextBlock Text="Start" />
                    </StackPanel>
                </Button>
                <Button AutomationProperties.Name="Save" Command="{x:Bind ViewModel.SaveCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE74E;" />
                        <TextBlock Text="Save…" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Skipped frames, run notices, save / error messages -->
        <StackPanel Grid.Row="1" Margin="12,0,12,4">
            <InfoBar
                Margin="0,0,0,4"
                IsOpen="{x:Bind ViewModel.ShowSkipped, Mode=TwoWay}"
                Severity="Warning"
                Title="{x:Bind ViewModel.SkippedTitle, Mode=OneWay}">
                <ScrollViewer MaxHeight="120" Margin="0,0,0,12">
                    <TextBlock IsTextSelectionEnabled="True" Text="{x:Bind ViewModel.SkippedMessage, Mode=OneWay}" TextWrapping="Wrap" />
                </ScrollViewer>
            </InfoBar>
            <InfoBar
                Margin="0,0,0,4"
                IsOpen="{x:Bind ViewModel.ShowNotice, Mode=TwoWay}"
                Message="{x:Bind ViewModel.NoticeText, Mode=OneWay}"
                Severity="Informational"
                Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}" />
            <InfoBar
                Margin="0,0,0,4"
                IsOpen="{x:Bind ViewModel.ShowMessage, Mode=TwoWay}"
                Message="{x:Bind ViewModel.MessageText, Mode=OneWay}"
                Severity="{x:Bind controls:ViewFormat.MessageSeverity(ViewModel.MessageIsError), Mode=OneWay}"
                Title="{x:Bind ViewModel.MessageTitle, Mode=OneWay}" />
        </StackPanel>

        <!-- 2. Live image -->
        <controls:LiveImageView
            x:Name="LiveView"
            Grid.Row="2"
            BackCommand="{x:Bind ViewModel.BackToResultCommand}"
            BadgeText="{x:Bind ViewModel.BadgeText, Mode=OneWay}"
            Hint="{x:Bind ViewModel.Hint, Mode=OneWay}"
            IsBackVisible="{x:Bind ViewModel.IsBackVisible, Mode=OneWay}" />

        <!-- 3. Thumbnail strip -->
        <ListView
            x:Name="Strip"
            Grid.Row="3"
            Height="100"
            Padding="8,6"
            AutomationProperties.Name="Frames"
            ContainerContentChanging="Strip_ContainerContentChanging"
            ItemsSource="{x:Bind ViewModel.Frames}"
            KeyDown="Strip_KeyDown"
            RightTapped="Strip_RightTapped"
            Tapped="Strip_Tapped"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.HorizontalScrollMode="Enabled"
            ScrollViewer.IsHorizontalRailEnabled="True"
            ScrollViewer.VerticalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollMode="Disabled"
            SelectionMode="Extended">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="2,0" />
                    <Setter Property="MinWidth" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem
                        Click="RemoveSelected_Click"
                        IsEnabled="{x:Bind ViewModel.CanEditFrames, Mode=OneWay}"
                        Text="Remove from list">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE74D;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </ListView.ContextFlyout>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:FrameItem">
                    <Grid
                        Width="96"
                        Height="68"
                        Background="#FF07090F"
                        BorderBrush="{x:Bind controls:ViewFormat.StateBrush(State), Mode=OneWay}"
                        BorderThickness="2"
                        CornerRadius="4"
                        ToolTipService.ToolTip="{x:Bind controls:ViewFormat.FrameTip(FileName, State, SkipReason), Mode=OneWay}">
                        <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill" />
                        <Border
                            Margin="3"
                            Padding="5,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="#FFF0A830"
                            CornerRadius="7"
                            Visibility="{x:Bind controls:ViewFormat.TrailBadge(State), Mode=OneWay}">
                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="Black"
                                Text="{x:Bind TrailCount, Mode=OneWay}" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 4. Status bar -->
        <Grid Grid.Row="4" Padding="12,6,12,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressBar
                VerticalAlignment="Center"
                Maximum="100"
                IsIndeterminate="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
            <Button
                Grid.Column="2"
                AutomationProperties.Name="Stop"
                Command="{x:Bind ViewModel.StopCommand}"
                Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE71A;" />
                    <TextBlock Text="Stop" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
