<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Orbitale.App</RootNamespace>
    <AssemblyName>Orbitale</AssemblyName>
    <!-- The installer (build-installer.ps1) takes its version from here. -->
    <Version>1.0.0</Version>
    <Product>Orbitale</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Orbitale.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\Orbitale.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Unpackaged WinUI: dotnet publish leaves out the compiled XAML (.xbf) and Orbitale.pri, so the published app
       would crash at startup with a XamlParseException. Add them to the publish set. -->
  <Target Name="IncludeXamlInPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_XamlPublish Include="$(OutDir)**\*.xbf;$(OutDir)Orbitale.pri" Exclude="$(OutDir)publish\**" />
      <ResolvedFileToPublish Include="@(_XamlPublish)" RelativePath="$([MSBuild]::MakeRelative('$(OutDir)', '%(_XamlPublish.FullPath)'))" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Orbitale.Engine\Orbitale.Engine.csproj" />
  </ItemGroup>

</Project>
