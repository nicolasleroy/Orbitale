<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\samples\*.jpg" LinkBase="samples" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Reference\*.png" LinkBase="Reference" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- UI-free scheduling class of the WinUI app, compiled in here so it can be unit-tested without hosting WinUI. -->
    <Compile Include="..\..\src\Orbitale.App\Services\ThumbnailQueue.cs" Link="App\ThumbnailQueue.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Orbitale.Engine\Orbitale.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>